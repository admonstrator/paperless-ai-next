<!DOCTYPE html>
<html lang="en" class="h-full<%= theme === 'dark' ? ' dark' : '' %>" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Ignored - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Ignored',
    version: typeof version !== 'undefined' ? version : '',
    chatEnabled: typeof chatEnabled !== 'undefined' ? chatEnabled : false
}) %>
            <div>
                <div class="zr-viewhead">
                    <div>
                        <p class="zr-viewhead__sub">
                            These documents are permanently skipped by automatic scanning. Use this for encrypted or otherwise unprocessable files.
                        </p>
                    </div>
                </div>

                <div class="zr-module mb-4">
                    <div class="zr-module__body">
                        <h2 class="zr-label">Add document to ignore list</h2>
                        <div class="flex gap-2 flex-wrap">
                            <input type="number" id="ignoreDocIdInput" placeholder="Document ID" min="1"
                                class="zr-select" style="max-width: 160px">
                            <input type="text" id="ignoreReasonInput" placeholder="Reason (optional)"
                                class="zr-input zr-grow">
                            <button id="ignoreAddBtn" class="zr-btn zr-btn--primary">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye-off"/></svg> Ignore
                            </button>
                        </div>
                    </div>
                </div>

                <div class="zr-module">
                    <div class="zr-table-wrap">
                        <table id="ignoredTable"  class="zr-table">
                            <thead>
                                <tr>
                                    <th >Doc ID</th>
                                    <th >Title</th>
                                    <th >Reason</th>
                                    <th >Added</th>
                                    <th >Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ignoredTableBody">
                                <tr>
                                    <td colspan="5" class="zr-empty">
                                        <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg> Loading ignored documents…
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="zr-table-foot">
                        <span id="ignoredTableInfo" class="zr-sm zr-faint"></span>
                        <div class="zr-inputgroup">
                            <button id="ignoredClearAllBtn" class="zr-btn zr-btn--danger" disabled>
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg> Clear All
                            </button>
                            <button id="ignoredPrevPageBtn" class="zr-btn" disabled>
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-left"/></svg> Prev
                            </button>
                            <button id="ignoredNextPageBtn" class="zr-btn" disabled>
                                Next <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <div id="toastNotification" class="zr-toasts hidden" style="z-index:9999;">
        <div id="toastInner" class="zr-toast zr-toast--ok">
            <svg class="zr-icon" id="toastIcon" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
            <span id="toastMessage">Done</span>
        </div>
    </div>

    <script src="/js/ignored.js"></script>
    <%- include('partials/shell/body-close') %>
