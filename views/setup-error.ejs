<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: title || 'System Error' }) %>
<%- include('partials/shell/head-end') %>
<body class="zr-errorpage">
    <div class="error-container">
        <div class="error-icon">⚠️</div>
        <h1><%= title %></h1>

        <div class="error-message">
            <strong>Error Details:</strong><br>
            <%= errorMessage %>
        </div>

        <div class="admin-notice">
            🔒 This is an administrative error state. Setup page is disabled to protect your configuration.
        </div>

        <div class="support-text">
            <strong>What to do:</strong><br>
            <%= supportText %>
        </div>

        <div class="action-buttons">
            <button onclick="location.reload()" class="zr-btn">Retry Connection</button>
            <a href="/" class="zr-btn zr-btn--primary">Return Home</a>
        </div>

        <div class="tech-details">
            <p>Status: System Configuration Error | Contact your administrator if this persists.</p>
        </div>
    </div>
</body>
</html>
