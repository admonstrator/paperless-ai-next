<!DOCTYPE html>
<html lang="en" class="h-full<%= theme === 'dark' ? ' dark' : '' %>" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Playground - Zettelrobbe' }) %>
    <script src="js/playground-analyzer.js" defer></script>
    <%- include('partials/shell/head-end') %>
    <%- include('partials/shell/body-open', {
    pageTitle: 'Playground',
    version: typeof version !== 'undefined' ? version : '',
        chatEnabled: typeof chatEnabled !== 'undefined' ? chatEnabled : false
    }) %>

        <!-- Main Content -->
            <div class="content-wrapper p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold mb-4">Documents</h1>
                <!-- Analysis Section -->
                <div class="zr-module mb-8">
                    <h2 class="card-title">Document Analysis</h2>
                    <div class="zr-col zr-col--loose">
                        <textarea 
                            id="analysisPrompt"
                            placeholder="Enter your analysis prompt here..."
                            class="toolbar-input"
                        ></textarea>
                        <div id="analysisActions" class="flex flex-wrap items-center gap-2">
                                <button id="analyzeButton" class="zr-btn zr-btn--primary">
                                Analyze Documents
                            </button>
                        </div>
                    </div>
                </div>

                <div id="playgroundInitialLoading" class="zr-module mb-4" role="status" aria-live="polite" aria-busy="true">
                    <div class="zr-row">
                        <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                        <div>
                            <div class="font-medium">Loading document previews...</div>
                            <div id="playgroundInitialLoadingStatus" class="zr-sm zr-muted">Preparing thumbnail requests...</div>
                        </div>
                    </div>
                </div>

                <!-- Documents Grid -->
                <div id="documentsGridWrapper" class="relative">
                    <div id="playgroundAnalysisOverlay" class="hidden absolute inset-0 z-10 flex items-center justify-center bg-white/75 dark:bg-slate-900/75 rounded-lg" role="status" aria-live="polite" aria-busy="true">
                        <div class="zr-module max-w-md w-full mx-4">
                            <div class="zr-row">
                                <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                <div>
                                    <div id="playgroundAnalysisStatus" class="font-medium">Analyzing documents...</div>
                                    <div class="zr-sm zr-muted">This can take a moment for larger batches.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-4 gap-4" id="documentsGrid"></div>
                </div>
            </div>
            </div>
    </div>

    <!-- Modal -->
    <div id="detailsModal" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title"></h3>
                <button class="modal-close">
                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
                </button>
            </div>
            <div class="modal-content">
                <div class="modal-loader hidden">
                    <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                    Loading...
                </div>
                <div class="modal-data"></div>
            </div>
        </div>
    </div>
    <script src="js/playground.js"></script>
    <%- include('partials/shell/body-close') %>