<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Failed - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Failed',
    version: typeof version !== 'undefined' ? version : '',
    chatEnabled: typeof chatEnabled !== 'undefined' ? chatEnabled : false
}) %>
            <div>
                <div class="zr-viewhead">
                    <p class="zr-viewhead__sub">
                        These documents are skipped by automatic scanning until you reset them.
                    </p>
                </div>

                <div class="zr-module" data-module="row-menu">
                    <div class="zr-table-wrap">
                        <table id="failedTable"  class="zr-table zr-table--stack">
                            <thead>
                                <tr>
                                    <th >Doc ID</th>
                                    <th >Title</th>
                                    <th >Reason</th>
                                    <th >Source</th>
                                    <th >Updated</th>
                                    <th class="zr-table__actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="failedTableBody">
                                <tr>
                                    <td colspan="6" class="zr-empty">
                                        <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg> Loading permanently failed queue…
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="zr-table-foot">
                        <span id="failedTableInfo" class="zr-sm zr-faint"></span>
                        <div class="zr-inputgroup">
                            <button id="failedResetAllBtn" class="zr-btn zr-btn--danger" disabled>
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-undo"/></svg> Reset All
                            </button>
                            <button id="failedPrevPageBtn" class="zr-btn" disabled>
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-left"/></svg> Prev
                            </button>
                            <button id="failedNextPageBtn" class="zr-btn" disabled>
                                Next <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <%- include('partials/scripts/failed-scripts') %>
    <script src="/js/failed.js"></script>
    <%- include('partials/shell/body-close') %>
