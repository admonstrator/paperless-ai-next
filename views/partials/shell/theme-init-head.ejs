<meta name="color-scheme" content="light dark">
<script>
    // Runs before first paint so the theme never flashes. The cookie is what the
    // server reads to render `data-theme` on the very first response.
    (function () {
        const KEY = 'theme';
        const COOKIE_MAX_AGE = 60 * 60 * 24 * 365;

        function normalize(value) {
            return value === 'dark' ? 'dark' : 'light';
        }

        function apply(theme) {
            const resolved = normalize(theme);
            const root = document.documentElement;

            root.setAttribute('data-theme', resolved);
            root.style.colorScheme = resolved;

            try {
                window.localStorage.setItem(KEY, resolved);
            } catch (_error) {
                // Ignore storage failures and keep the in-memory theme.
            }

            try {
                let cookie = `${KEY}=${resolved}; Path=/; Max-Age=${COOKIE_MAX_AGE}; SameSite=Lax`;
                if (window.location && window.location.protocol === 'https:') {
                    cookie += '; Secure';
                }
                document.cookie = cookie;
            } catch (_error) {
                // Ignore cookie write failures.
            }

            return resolved;
        }

        function stored() {
            const match = document.cookie
                .split('; ')
                .find((entry) => entry.startsWith(`${KEY}=`));

            if (match) {
                return normalize(match.split('=')[1]);
            }

            try {
                return normalize(window.localStorage.getItem(KEY));
            } catch (_error) {
                return 'light';
            }
        }

        window.zrTheme = { apply: apply, get: stored };
        apply(stored());
    })();
</script>
