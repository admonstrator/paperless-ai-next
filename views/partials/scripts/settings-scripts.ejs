<script>
    document.addEventListener('DOMContentLoaded', function() {
        const apiKeyContainer = document.getElementById('apiKeyContainer');
        const regenerateBtn = document.getElementById('regenerateBtn');
        const regenerateIcon = document.getElementById('regenerateIcon');

        if (!apiKeyContainer || !regenerateBtn || !regenerateIcon) {
            return;
        }

        /* The kernel owns the toast. This file used to build its own
           notification box and drive it through an <i> element the UI
           migration had already removed, so every call threw before showing
           anything — including the one in loadCurrentApiKey()'s catch. */
        function showToast(message, type = 'success') {
            if (typeof window.__zrToast !== 'function') return null;
            return window.__zrToast(message, {
                tone: type === 'error' ? 'danger' : 'ok',
            });
        }

        async function loadCurrentApiKey() {
            try {
                const response = await fetch('/api/settings/api-key', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to load API key');
                }

                const data = await response.json();
                const keyValue = data && data.apiKey ? data.apiKey : '';

                if (keyValue) {
                    apiKeyContainer.textContent = keyValue;
                    apiKeyContainer.dataset.apiKey = keyValue;
                    apiKeyContainer.title = keyValue;
                    return;
                }

                apiKeyContainer.textContent = 'Not configured';
                apiKeyContainer.dataset.apiKey = '';
                apiKeyContainer.title = 'No API key configured';
            } catch (error) {
                console.error('Error loading API key:', error);
                apiKeyContainer.textContent = 'Unavailable';
                apiKeyContainer.dataset.apiKey = '';
                apiKeyContainer.title = 'Failed to load API key';
                showToast('Failed to load API key!', 'error');
            }
        }

        async function copyApiKey() {
            if (!apiKeyContainer.dataset.apiKey) {
                showToast('No API key available to copy', 'error');
                return;
            }

            try {
                await navigator.clipboard.writeText(apiKeyContainer.dataset.apiKey);
                showToast('API key copied to clipboard!');
            } catch (err) {
                showToast('Failed to copy API key!', 'error');
            }
        }

        apiKeyContainer.addEventListener('click', copyApiKey);

        /* The container is a role="button" with tabindex, so it has to answer
           the keys a button answers — it looked focusable but did nothing. */
        apiKeyContainer.addEventListener('keydown', function(event) {
            if (event.key !== 'Enter' && event.key !== ' ') {
                return;
            }
            event.preventDefault();
            copyApiKey();
        });

        /* The key is blurred until it is hovered or focused — that is .zr-apikey
           in forms.css, not something this script has to toggle. */

        regenerateBtn.addEventListener('click', async function() {
            this.disabled = true;
            regenerateIcon.classList.add('zr-icon--spin');

            try {
                const response = await fetch('/api/key-regenerate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const data = await response.json();

                    await new Promise(resolve => setTimeout(resolve, 5000));

                    apiKeyContainer.textContent = data.newKey;
                    apiKeyContainer.dataset.apiKey = data.newKey;
                    apiKeyContainer.title = data.newKey;

                    showToast('New API key generated!');
                } else {
                    throw new Error('Failed to regenerate key');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Failed to regenerate API key!', 'error');
            } finally {
                regenerateBtn.disabled = false;
                regenerateIcon.classList.remove('zr-icon--spin');
            }
        });

        loadCurrentApiKey();
    });
</script>
