<script>
	document.addEventListener('DOMContentLoaded', () => {
		const openPrefilledIssueBtn = document.getElementById('openPrefilledIssueBtn');
		const copyIssueDiagnosticsBtn = document.getElementById('copyIssueDiagnosticsBtn');
		const issueHelperStatus = document.getElementById('issueHelperStatus');
		const supportInfoPayload = document.getElementById('supportInfoPayload');

		if (!openPrefilledIssueBtn || !supportInfoPayload) {
			return;
		}

		let supportInfo = {};
		try {
			supportInfo = JSON.parse(supportInfoPayload.textContent || '{}');
		} catch (error) {
			console.error('Failed to parse support info payload:', error);
		}

		const browserInfo = `${navigator.userAgent || 'unknown'}`;
		const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';

		// Redaction and the issue URL live in /js/bug-report-link.js, so this page
		// and the sidebar link cannot drift apart. Without that script the button
		// keeps its static template href and diagnostics stay placeholder-only —
		// never print a value the shared redaction rules have not seen.
		const bugReport = window.zrBugReport;
		if (!bugReport) {
			console.warn('bug-report-link.js unavailable; issue prefill disabled.');
		}

		const redactSecrets = (value) =>
			bugReport ? bugReport.redactSecrets(value) : 'unavailable';
		const keyState = (isSet) =>
			bugReport ? bugReport.keyState(isSet) : 'unknown';

		if (bugReport) {
			bugReport.apply(openPrefilledIssueBtn, supportInfo);
		}

		if (!copyIssueDiagnosticsBtn) {
			return;
		}

		copyIssueDiagnosticsBtn.addEventListener('click', async () => {
			const diagnostics = [
				'Zettelrobbe diagnostics',
				`App Version: ${supportInfo.appVersion || 'unknown'}`,
				`Commit SHA: ${supportInfo.commitSha || 'unknown'}`,
				`Paperless-ngx Version: ${supportInfo.paperlessNgxVersion || 'unknown'}`,
				`Node.js: ${supportInfo.nodeVersion || 'unknown'}`,
				`Platform: ${supportInfo.platform || 'unknown'}`,
				`Environment: ${supportInfo.nodeEnv || 'unknown'}`,
				`AI Provider: ${supportInfo.aiProvider || 'unknown'}`,
				`Mistral OCR Enabled: ${supportInfo.ocrEnabled ? 'yes' : 'no'}`,
				`Paperless API URL: ${redactSecrets(supportInfo.paperlessApiUrl || 'unknown')}`,
				`Ollama API URL: ${redactSecrets(supportInfo.ollamaApiUrl || 'unknown')}`,
				`Ollama Model: ${supportInfo.ollamaModel || 'unknown'}`,
				`Custom Base URL: ${redactSecrets(supportInfo.customBaseUrl || 'unknown')}`,
				`Custom Model: ${supportInfo.customModel || 'unknown'}`,
				`Azure Endpoint: ${redactSecrets(supportInfo.azureEndpoint || 'unknown')}`,
				`Azure Deployment: ${supportInfo.azureDeploymentName || 'unknown'}`,
				`Azure API Version: ${supportInfo.azureApiVersion || 'unknown'}`,
				`Mistral OCR Model: ${supportInfo.mistralOcrModel || 'unknown'}`,
				`Scan Interval: ${supportInfo.scanInterval || 'unknown'}`,
				`Token Limit: ${supportInfo.tokenLimit || 'unknown'}`,
				`Response Tokens: ${supportInfo.responseTokens || 'unknown'}`,
				`Trust Proxy: ${supportInfo.trustProxy || 'unknown'}`,
				`OpenAI API Key: ${keyState(supportInfo.openAiKeySet)}`,
				`Custom API Key: ${keyState(supportInfo.customKeySet)}`,
				`Azure API Key: ${keyState(supportInfo.azureKeySet)}`,
				`Mistral API Key: ${keyState(supportInfo.mistralKeySet)}`,
				`Paperless API Token: ${keyState(supportInfo.paperlessTokenSet)}`,
				`App API Key: ${keyState(supportInfo.apiKeySet)}`,
				`Server Time (UTC): ${supportInfo.serverTimeUtc || 'unknown'}`,
				`Server Timezone: ${supportInfo.timezone || 'unknown'}`,
				`Host Browser: ${browserInfo}`,
				`Client Timezone: ${timezone}`
			].join('\n');

			try {
				await navigator.clipboard.writeText(diagnostics);
				if (issueHelperStatus) {
					issueHelperStatus.textContent = 'Diagnostics copied to clipboard.';
				}
			} catch (error) {
				console.error('Failed to copy diagnostics:', error);
				if (issueHelperStatus) {
					issueHelperStatus.textContent = 'Could not copy diagnostics. Please copy manually.';
				}
			}
		});
	});
</script>
