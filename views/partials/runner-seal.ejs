<%#
    The seal sorting documents, shown in the task runner while a scan is on.

    The seal herself is public/mascot-animated.svg scaled onto this wide scene:
    every coordinate below is the mascot's, mapped at ~0.18 with the face
    centred on x=100 — same egg body, same small muzzle low on the face with
    the nose and W mouth on it, eyes on the blue above it, cheeks, whisker
    dots, crown speckles, and the same slim flippers. Redrawing her freehand
    is what previously made her read as a penguin in a hood, with a flipper
    three times the size the mascot has.

    Draw order is the choreography: she picks a sheet off the left pile, holds
    it up in front of herself, and lays it on the right one. The sheet is drawn
    last of everything, so it stays on top for the whole journey — over her
    fins and belly while she holds it, the way a real sheet would, and over the
    sorted pile as she sets it down. It used to sit before that pile and so
    slid behind it at the end, as though she were posting it into a slot.

    The animation lives in pages/dashboard.css, keyed off .is-scanning on the
    card, so nothing moves when no scan is running. The sheet's transform
    attribute is the held pose for static rendering; the CSS animation
    overrides it live.
-%>
<div class="runner-seal" aria-hidden="true">
    <svg viewBox="0 0 200 96" role="presentation" focusable="false">
        <!-- the pile still to be read, on the left -->
        <g class="runner-seal__inbox">
            <rect x="2" y="70" width="42" height="20" rx="3" fill="#C3D4E2"/>
            <rect x="5" y="62" width="42" height="20" rx="3" fill="#D9E4EC"/>
            <rect x="8" y="54" width="42" height="20" rx="3" fill="#FDFBF5"/>
            <rect x="16" y="61" width="18" height="4" rx="2" fill="#C3D4E2"/>
        </g>

        <!-- the seal -->
        <g class="runner-seal__body">
            <ellipse cx="100" cy="91" rx="30" ry="4" fill="#12314E" opacity="0.08"/>

            <!-- tail flippers, behind the body: the mascot's two overlapping fins -->
            <g class="runner-seal__tail">
                <path d="M 120 86.2 C 124.5 84 134 83.4 140.2 85.8 C 142 86.5 141.8 88.1 139.9 88.4
                         C 133 89.3 125.8 88.6 121.2 87.2 Z" fill="#6486A6"/>
                <path d="M 119.5 85 C 123 80.5 131 76 139.5 75 C 141.5 74.7 142.2 76 140.8 77.5
                         C 136.5 81.7 129 84.8 122.8 85.8 Z" fill="#7495B4"/>
            </g>

            <!-- the egg body, narrow at the crown and widest low -->
            <path d="M 100 22 C 87 22 78 30.5 77.5 41.5 C 74.5 46.5 71.5 56 71.5 67
                     C 71.5 80 78.5 91 100 91 C 121.5 91 128.5 80 128.5 67
                     C 128.5 56 125.5 46.5 122.5 41.5 C 122 30.5 113 22 100 22 Z" fill="#8FADC8"/>
            <path d="M 100 22 C 113 22 122 30.5 122.5 41.5 C 125.5 46.5 128.5 56 128.5 67
                     C 128.5 80 121.5 91 100 91 Z" fill="#7495B4" opacity="0.35"/>

            <!-- belly -->
            <ellipse cx="100" cy="74" rx="15" ry="16" fill="#EAF2F8"/>

            <!-- her flippers, the mascot's own scaled down: the left one
                 reaches for the pile and pushes the sheet in, the right one
                 takes over and lays it down. Inside the body group so they
                 breathe with her — and behind the sheet, which hides them
                 while she holds it. -->
            <g class="runner-seal__flipper">
                <path d="M 81.7 63.4 C 76.8 66.5 73.7 71 73 75.8 C 72.8 78.2 75.3 79.1 77.4 77.5
                         C 80.6 74.8 82.9 68.9 83.6 64.4 Z" fill="#7495B4"/>
            </g>
            <g class="runner-seal__flipper runner-seal__flipper--place">
                <path d="M 118.3 63.4 C 123.2 66.5 126.3 71 127 75.8 C 127.2 78.2 124.7 79.1 122.6 77.5
                         C 119.4 74.8 117.1 68.9 116.4 64.4 Z" fill="#7E9FBD"/>
            </g>

            <g class="runner-seal__head">
                <!-- crown speckles -->
                <g fill="#5F7F9E" opacity="0.45">
                    <circle cx="93" cy="31.5" r="0.8"/>
                    <circle cx="99.3" cy="29.5" r="0.6"/>
                    <circle cx="105.5" cy="32" r="0.8"/>
                </g>
                <!-- muzzle, small and low: the eyes stay on the blue above it -->
                <ellipse cx="100" cy="52.5" rx="11.5" ry="7.5" fill="#EAF2F8"/>
                <g class="runner-seal__eyes">
                    <circle cx="88.5" cy="43" r="4" fill="#12314E"/>
                    <circle cx="111.5" cy="43" r="4" fill="#12314E"/>
                    <circle cx="89.8" cy="41.5" r="1.5" fill="#FFFFFF"/>
                    <circle cx="112.8" cy="41.5" r="1.5" fill="#FFFFFF"/>
                    <circle cx="87.2" cy="44.5" r="0.8" fill="#FFFFFF" opacity="0.75"/>
                    <circle cx="110.2" cy="44.5" r="0.8" fill="#FFFFFF" opacity="0.75"/>
                </g>
                <path d="M 97 47.3 Q 100 45.7 103 47.3 Q 101.9 51 100 51.4 Q 98.1 51 97 47.3 Z"
                      fill="#12314E"/>
                <path d="M 100 51.4 Q 99.5 54.8 96.2 53.3" fill="none" stroke="#12314E"
                      stroke-width="1.2" stroke-linecap="round"/>
                <path d="M 100 51.4 Q 100.5 54.8 103.8 53.3" fill="none" stroke="#12314E"
                      stroke-width="1.2" stroke-linecap="round"/>
                <g fill="#12314E" opacity="0.45">
                    <circle cx="91.5" cy="51" r="0.6"/>
                    <circle cx="90" cy="53" r="0.6"/>
                    <circle cx="92" cy="55" r="0.6"/>
                    <circle cx="108.5" cy="51" r="0.6"/>
                    <circle cx="110" cy="53" r="0.6"/>
                    <circle cx="108" cy="55" r="0.6"/>
                </g>
                <ellipse cx="82" cy="51.5" rx="4.6" ry="2.4" fill="#F49B86" opacity="0.6"
                         transform="rotate(-8 82 51.5)"/>
                <ellipse cx="118" cy="51.5" rx="4.6" ry="2.4" fill="#F49B86" opacity="0.6"
                         transform="rotate(8 118 51.5)"/>
            </g>
        </g>

        <!-- the sorted pile, on the right, with the tick that fires as a sheet lands -->
        <g class="runner-seal__outbox">
            <rect x="152" y="70" width="42" height="20" rx="3" fill="#C3D4E2"/>
            <rect x="155" y="62" width="42" height="20" rx="3" fill="#D9E4EC"/>
            <rect x="158" y="54" width="42" height="20" rx="3" fill="#FDFBF5"/>
            <rect x="166" y="61" width="18" height="4" rx="2" fill="#27A69A"/>
            <g class="runner-seal__tick">
                <circle cx="186" cy="42" r="9" fill="#27A69A"/>
                <path d="M 182 42 L 185 45.5 L 190.5 38.5" fill="none" stroke="#FFFFFF"
                    stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </g>
        </g>

        <!-- the sheet she is working on: lifted off the left pile, held up in
             front of her — covering the fins that hold it — and laid on the
             right one. -->
        <g class="runner-seal__sheet" transform="translate(100 70) rotate(-2)">
            <rect x="-21" y="-13" width="42" height="26" rx="3" fill="#FDFBF5"/>
            <rect x="-13" y="-6" width="19" height="5" rx="2.5" fill="#27A69A"/>
            <rect x="-13" y="3" width="25" height="3" rx="1.5" fill="#C3D4E2"/>
            <rect x="-13" y="9" width="16" height="3" rx="1.5" fill="#C3D4E2"/>
        </g>
    </svg>
</div>
