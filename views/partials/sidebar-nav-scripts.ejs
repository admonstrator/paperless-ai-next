<%#
    Data only: the running configuration the GitHub bug report is prefilled
    with. The prefill itself lives in public/js/bug-report-link.js, which reads
    this payload and wires the link named by data-bug-report-target. Keys match
    the About page's supportInfo shape so both callers share one contract.
-%>
<script type="application/json" id="sidebarBugReportPayload" data-bug-report-payload
    data-bug-report-target="#sidebarBugReportLink"><%- JSON.stringify({
        appVersion: appVersion || 'unknown',
        commitSha: appCommitSha || 'unknown',
        paperlessNgxVersion: appPaperlessNgxVersion || 'unknown',
        nodeVersion: appNodeVersion || 'unknown',
        platform: appPlatform || 'unknown',
        nodeEnv: appNodeEnv || 'unknown',
        aiProvider: appAiProvider || 'unknown',
        ocrEnabled: Boolean(appOcrEnabled),
        serverTimeUtc: appServerTimeUtc || 'unknown',
        timezone: appServerTimezone || 'unknown',
        paperlessApiUrl: appPaperlessApiUrl || 'unknown',
        ollamaApiUrl: appOllamaApiUrl || 'unknown',
        ollamaModel: appOllamaModel || 'unknown',
        customBaseUrl: appCustomBaseUrl || 'unknown',
        customModel: appCustomModel || 'unknown',
        azureEndpoint: appAzureEndpoint || 'unknown',
        azureDeploymentName: appAzureDeploymentName || 'unknown',
        azureApiVersion: appAzureApiVersion || 'unknown',
        mistralOcrModel: appMistralOcrModel || 'unknown',
        scanInterval: appScanInterval || 'unknown',
        tokenLimit: appTokenLimit || 'unknown',
        responseTokens: appResponseTokens || 'unknown',
        trustProxy: appTrustProxy || 'unknown',
        useExistingData: appUseExistingData || 'no',
        restrictToExistingTags: appRestrictTags || 'no',
        restrictToExistingCorrespondents: appRestrictCorrespondents || 'no',
        restrictToExistingDocumentTypes: appRestrictDocumentTypes || 'no',
        paperlessTokenSet: Boolean(appPaperlessTokenSet),
        openAiKeySet: Boolean(appOpenAiKeySet),
        customKeySet: Boolean(appCustomKeySet),
        azureKeySet: Boolean(appAzureKeySet),
        mistralKeySet: Boolean(appMistralKeySet),
        apiKeySet: Boolean(appApiKeySet)
    }).replace(/</g, '\\u003c') %></script>
