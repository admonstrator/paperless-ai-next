<!-- What's New dialog — shown once per release, skipped on the login page (API returns 401).
     Filled and opened by /js/changelog-modal.js, loaded from the shell. -->
<dialog id="changelogModal" class="zr-dialog" aria-labelledby="changelogModalTitle">
    <div class="zr-dialog__head">
        <span class="zr-badge zr-badge--brand">
            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-zap"/></svg>
        </span>
        <span class="zr-grow">
            <span id="changelogModalTitle">What's new</span>
            <span id="changelogModalVersion" class="zr-sm zr-faint"></span>
        </span>
        <button class="zr-btn zr-btn--ghost zr-btn--icon" type="button" id="changelogModalClose"
            aria-label="Close what's new">
            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
        </button>
    </div>
    <div class="zr-dialog__body">
        <ul class="zr-changelog-list" id="changelogModalEntries"></ul>
    </div>
    <div class="zr-dialog__foot zr-dialog__foot--split">
        <a class="zr-btn zr-btn--ghost" href="https://github.com/admonstrator/zettelrobbe/releases" target="_blank"
            rel="noopener noreferrer">
            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-external"/></svg>
            Release notes
        </a>
        <button class="zr-btn zr-btn--primary" type="button" id="changelogModalDismiss">Got it</button>
    </div>
</dialog>
