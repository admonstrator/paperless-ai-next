<!DOCTYPE html>
<html lang="en" class="h-full<%= theme === 'dark' ? ' dark' : '' %>" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Manual - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Manual',
    version: typeof version !== 'undefined' ? version : '',
    chatEnabled: typeof chatEnabled !== 'undefined' ? chatEnabled : false
}) %>
            <div>
                <!-- Message Area -->
                <div id="messageArea" class="mb-6 hidden">
                    <!-- Messages will be inserted here -->
                </div>
        
                <!-- Document Selection -->
                <div class="zr-module mb-6">
                    <h2 class="zr-module__title">Select Document</h2>
                    <div class="manual-search-wrapper">
                        <input
                            id="manualDocumentSearchInput"
                            class="zr-input"
                            type="search"
                            placeholder="Search documents (title, ID, correspondent)..."
                            autocomplete="off">
                        <div id="manualDocumentSearchResults" class="manual-search-results hidden" role="listbox" aria-label="Manual document search results"></div>
                        <input type="hidden" id="documentSelect" value="">
                        <p id="manualDocumentSearchStatus" class="manual-search-status">Loading recent documents...</p>
                    </div>
                </div>
        
                <!-- Main Grid -->
                <div class="card-grid">
                    <!-- Document Preview Card -->
                    <div class="zr-module col-span-2">
                        <h2 class="zr-module__title">Document Preview</h2>
                        <!-- Correspondent Info -->
                        <div id="correspondentInfo" class="stat-box mb-4 hidden">
                            <h3 class="zr-field__name">Correspondent:</h3>
                            <p id="correspondentName"></p>
                        </div>
                        <div id="titleInfo" class="stat-box mb-4 hidden">
                            <h3 class="zr-field__name">Title:</h3>
                            <p id="titleName"></p>
                        </div>
                        <div class="stat-box">
                            <div id="documentPreview" class="min-h-[600px] bg-bg-primary rounded border border-border-color p-4">
                                <div id="contentPreview" class="h-[600px] overflow-y-auto font-mono text-sm whitespace-pre-wrap"></div>
                            </div>
                        </div>
                    </div>
        
                    <!-- AI and Tags Section -->
                    <div class="col-span-2">
                        <!-- AI Analysis Card -->
                        <div class="zr-module mb-6">
                            <h2 class="zr-module__title">AI Analysis</h2>
                            <button id="analyzeBtn" 
                                    class="zr-btn zr-btn--block" 
                                    disabled>
                                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-cpu"/></svg>
                                    Analyze with AI
                            </button>
                            <div id="aiStatus" class="mt-4 hidden">
                                <div class="flex items-center">
                                    <div class="mr-3">
                                        <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                    </div>
                                    <div class="text-sm text-text-secondary">
                                        AI is analyzing the document...
                                    </div>
                                </div>
                            </div>
                        </div>
        
                        <!-- Tags Card -->
                        <div class="zr-module">
                            <h2 class="zr-module__title">Tags</h2>
                            <!-- AI Suggested Tags -->
                            <div >
                                <h3 class="zr-field__name">AI Suggestions</h3>
                                <div id="suggestedTags" class="zr-row zr-row--wrap"></div>
                                <input type="hidden" id="tags" name="tags" value="">
                            </div>
        
                            <!-- Current Tags -->
                            <div >
                                <div class="flex justify-between items-center mb-2">
                                    <h3 class="text-sm font-medium text-text-secondary">Current Tags</h3>
                                    <button id="saveTagsBtn" 
                                            class="zr-btn zr-btn--primary">
                                        Save Tags
                                    </button>
                                </div>
                                <div id="currentTags" class="zr-row zr-row--wrap"></div>
                            </div>
        
                            <!-- Add New Tag -->
                            <div>
                                <h3 class="zr-field__name">Add New Tag</h3>
                                <div class="flex space-x-2">
                                    <select id="newTagSelect" class="flex-1 rounded-md border-border-color bg-bg-primary text-text-primary focus:border-accent-primary focus:ring-accent-primary">
                                        <option value="">Select a tag...</option>
                                    </select>
                                    <button id="addTagBtn" class="zr-btn zr-btn--primary">
                                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                    </button>
                                    <input type="hidden" id="hiddenId" value="">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/document-omnibox.js"></script>
    <%- include('partials/scripts/manual-scripts') %>
    <%- include('partials/shell/body-close') %>