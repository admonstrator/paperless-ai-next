<!-- views/ocr.ejs -->
<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'OCR Queue - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'OCR Queue',
    version: typeof version !== 'undefined' ? version : '',
    chatEnabled: typeof chatEnabled !== 'undefined' ? chatEnabled : false
}) %>

            <div>
                <div class="zr-viewhead">
                    <div class="zr-grow">
                        <p class="zr-viewhead__sub">
                            Documents with missing or insufficient OCR text queued for OCR reprocessing.
                        </p>
                    </div>
                    <% if (ocrEnabled) { %>
                    <div class="zr-viewhead__actions">
                        <!-- Stats badges -->
                        <span id="statPending" class="status-badge status-pending"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-clock"/></svg> <span id="statPendingCount">…</span> pending</span>
                        <span id="statDone" class="status-badge status-done"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check"/></svg> <span id="statDoneCount">…</span> done</span>
                        <span id="statFailed" class="status-badge status-failed"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg> <span id="statFailedCount">…</span> failed</span>
                    </div>
                    <% } %>
                </div>

                <% if (!ocrEnabled) { %>
                <!-- Feature disabled notice -->
                <div class="zr-module">
                    <div class="disabled-overlay">
                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-eye-off"/></svg>
                        <h2 class="zr-viewhead__title">OCR is not enabled</h2>
                        <p class="zr-muted">
                            Enable OCR in settings and configure your OCR provider. You can optionally set these values in <strong>data/.env</strong> and restart the service:
                        </p>
                        <pre class="ocr-env-codeblock">MISTRAL_OCR_ENABLED=yes
OCR_PROVIDER=mistral|custom
OCR_API_URL=http://localhost:11434
OCR_API_KEY=optional_or_required_provider_key
MISTRAL_OCR_MODEL=mistral-ocr-latest</pre>
                        <p class="zr-xs zr-faint">Choose the provider and endpoint that match your OCR backend.</p>
                    </div>
                </div>
                <% } %>

                <% if (ocrEnabled) { %>

                <!-- Toolbar -->
                <div class="zr-module">
                    <div class="app-toolbar app-toolbar--triple">
                    <!-- Manual add -->
                    <div class="app-toolbar-main">
                        <div class="manual-search-wrapper">
                            <input
                                id="manualDocSearchInput"
                                class="zr-input"
                                type="search"
                                placeholder="Search documents..."
                                autocomplete="off">
                            <div id="manualDocSearchResults" class="manual-search-results hidden" role="listbox" aria-label="OCR document search results"></div>
                            <input type="hidden" id="manualDocId" value="">
                            <p id="manualDocSearchStatus" class="manual-search-status">Type to search documents...</p>
                            <div id="searchModeToggles" class="search-mode-toggles">
                                <button type="button" class="search-mode-btn active" data-mode="all">All</button>
                                <button type="button" class="search-mode-btn" data-mode="id">ID</button>
                                <button type="button" class="search-mode-btn" data-mode="title">Title</button>
                                <button type="button" class="search-mode-btn" data-mode="tags">Tags</button>
                                <button type="button" class="search-mode-btn" data-mode="correspondent">Correspondent</button>
                            </div>
                        </div>
                    </div>

                    <div class="app-toolbar-controls">
                        <!-- Auto-analyze toggle -->
                        <label class="zr-switch">
                            <input type="checkbox" id="autoAnalyzeToggle">
                            <span class="zr-switch__track"><span class="zr-switch__thumb"></span></span>
                            <span class="zr-switch__text">AI analysis after OCR</span>
                        </label>

                        <!-- Status filter -->
                        <select id="statusFilter" class="app-toolbar-filter toolbar-input ocr-toolbar-filter">
                            <option value="">All statuses</option>
                            <option value="pending">Pending</option>
                            <option value="processing">Processing</option>
                            <option value="done">Done</option>
                            <option value="failed">Failed</option>
                        </select>
                    </div>

                    <div class="app-toolbar-actions">
                        <!-- Process all button -->
                        <button id="processAllBtn"
                                class="zr-btn"
                                title="Process all pending items">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-play"/></svg> Process All Pending
                        </button>
                    </div>
                    </div>
                </div>

                <!-- Queue Table -->
                <div class="zr-module">
                    <div class="zr-table-wrap">
                        <table id="ocrTable"  class="zr-table">
                            <thead>
                                <tr>
                                    <th >Doc ID</th>
                                    <th >Title</th>
                                    <th >Reason</th>
                                    <th >Status</th>
                                    <th >Added</th>
                                    <th >Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ocrTableBody">
                                <tr>
                                    <td colspan="6" class="zr-empty">
                                        <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg> Loading queue…
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="zr-table-foot">
                        <span id="tableInfo" class="zr-sm zr-faint"></span>
                        <div class="zr-inputgroup">
                            <button id="prevPageBtn" class="zr-btn" disabled>
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-left"/></svg> Prev
                            </button>
                            <button id="nextPageBtn" class="zr-btn" disabled>
                                Next <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
                <% } %>

            </div>
    </div>

    <!-- Progress Overlay (SSE) -->
    <div id="progressOverlay" style="display:none;">
        <div id="progressBox">
            <div class="zr-row zr-row--between">
                <h3 id="progressTitle" class="zr-module__title">Processing…</h3>
                <button id="progressCloseBtn" class="zr-btn" style="display:none;" aria-label="Close progress overlay">
                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
                </button>
            </div>

            <!-- Progress bar -->
            <div class="zr-meter">
                <div id="progressBar" class="zr-meter__fill" style="width:0%"></div>
            </div>

            <div id="progressLog"></div>

            <div class="zr-row">
                <button id="progressDoneBtn" class="zr-btn zr-btn--primary" style="display:none;">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div id="toastNotification" class="zr-toasts hidden" style="z-index:9999;">
        <div id="toastInner" class="zr-toast zr-toast--ok">
            <svg class="zr-icon" id="toastIcon" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
            <span id="toastMessage">Done</span>
        </div>
    </div>

    <%- include('partials/scripts/ocr-scripts') %>
    <script src="/js/document-omnibox.js"></script>
    <script src="/js/ocr.js"></script>
    <%- include('partials/shell/body-close') %>