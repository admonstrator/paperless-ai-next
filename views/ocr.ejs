<!-- views/ocr.ejs -->
<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'OCR Queue - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'OCR Queue',
    version: typeof version !== 'undefined' ? version : '',
    chatEnabled: typeof chatEnabled !== 'undefined' ? chatEnabled : false
}) %>

            <div>
                <div class="zr-viewhead">
                    <p class="zr-viewhead__sub">
                        Documents with missing or insufficient OCR text queued for OCR reprocessing.
                    </p>
                    <% if (ocrEnabled) { %>
                    <div class="zr-viewhead__actions">
                        <!-- Stats badges -->
                        <span id="statPending" class="zr-badge zr-badge--warn"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-clock"/></svg> <span id="statPendingCount">…</span> pending</span>
                        <span id="statDone" class="zr-badge zr-badge--ok"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check"/></svg> <span id="statDoneCount">…</span> done</span>
                        <!-- Hidden at zero: on a healthy instance this badge
                             never shows, and an empty one would only teach
                             people to ignore it. -->
                        <span id="statNotWrittenBack" class="zr-badge zr-badge--warn hidden" title="Paperless-ngx did not accept the content. The OCR text of these documents exists only in the queue."><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg> <span id="statNotWrittenBackCount">…</span> not written back</span>
                        <span id="statFailed" class="zr-badge zr-badge--danger"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg> <span id="statFailedCount">…</span> failed</span>
                    </div>
                    <% } %>
                </div>

                <% if (!ocrEnabled) { %>
                <!-- Feature disabled notice -->
                <div class="zr-module">
                    <div class="disabled-overlay">
                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-eye-off"/></svg>
                        <h2 class="zr-viewhead__title">OCR is not enabled</h2>
                        <p class="zr-muted">
                            Enable OCR in settings and configure your OCR provider. You can optionally set these values in <strong>data/.env</strong> and restart the service:
                        </p>
                        <pre class="ocr-env-codeblock">MISTRAL_OCR_ENABLED=yes
OCR_PROVIDER=mistral|custom
OCR_API_URL=http://localhost:11434
OCR_API_KEY=optional_or_required_provider_key
MISTRAL_OCR_MODEL=mistral-ocr-latest</pre>
                        <p class="zr-xs zr-faint">Choose the provider and endpoint that match your OCR backend.</p>
                    </div>
                </div>
                <% } %>

                <% if (ocrEnabled) { %>

                <!-- Toolbar -->
                <div class="zr-module">
                    <!-- One row, one control height. The search field, its
                         scope and the status filter sit on the left, the two
                         actions on the right. -->
                    <div class="app-toolbar">
                        <div class="manual-search-wrapper">
                            <select id="searchModeSelect" class="zr-select app-toolbar-scope" aria-label="Search in">
                                <option value="all">All fields</option>
                                <option value="id">ID</option>
                                <option value="title">Title</option>
                                <option value="tags">Tags</option>
                                <option value="correspondent">Correspondent</option>
                            </select>
                            <!-- Field and results share one box: the results
                                 panel is positioned against it and drops over
                                 the page, instead of taking a third slot on
                                 the toolbar row next to the field. -->
                            <div class="manual-search-anchor">
                                <input
                                    id="manualDocSearchInput"
                                    class="zr-input"
                                    type="search"
                                    placeholder="Search documents to add..."
                                    autocomplete="off">
                                <div id="manualDocSearchResults" class="manual-search-results hidden" role="listbox" aria-label="OCR document search results"></div>
                                <input type="hidden" id="manualDocId" value="">
                            </div>
                        </div>

                        <select id="statusFilter" class="zr-select app-toolbar-scope">
                            <option value="">All statuses</option>
                            <option value="pending">Pending</option>
                            <option value="processing">Processing</option>
                            <option value="done">Done</option>
                            <option value="failed">Failed</option>
                        </select>

                        <span class="zr-grow"></span>

                        <label class="zr-row" title="Applies to the runs you start on this page and is remembered in this browser. The scheduled queue drain follows Settings &rarr; OCR &rarr; AI Analysis After OCR.">
                            <input type="checkbox" class="zr-toggle" id="autoAnalyzeToggle" <%= (typeof ocrAutoAnalyze !== 'undefined' && ocrAutoAnalyze) ? 'checked' : '' %>>
                            <span>AI analysis after OCR</span>
                        </label>

                        <button id="processAllBtn"
                                class="zr-btn zr-btn--primary"
                                title="Process all pending items">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-play"/></svg> Process All Pending
                        </button>
                    </div>
                    <!-- Live search feedback only; empty while idle. -->
                    <p id="manualDocSearchStatus" class="manual-search-status zr-xs"></p>
                </div>

                <!-- Queue Table -->
                <div class="zr-module" data-module="row-menu">
                    <div class="zr-table-wrap">
                        <table id="ocrTable"  class="zr-table zr-table--stack">
                            <thead>
                                <tr>
                                    <th >Doc ID</th>
                                    <th >Title</th>
                                    <th >Reason</th>
                                    <th >Status</th>
                                    <th >Added</th>
                                    <th class="zr-table__actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ocrTableBody">
                                <tr>
                                    <td colspan="6" class="zr-empty">
                                        <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg> Loading queue…
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="zr-table-foot">
                        <span id="tableInfo" class="zr-sm zr-faint"></span>
                        <div class="zr-inputgroup">
                            <button id="prevPageBtn" class="zr-btn" disabled>
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-left"/></svg> Prev
                            </button>
                            <button id="nextPageBtn" class="zr-btn" disabled>
                                Next <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
                <% } %>

            </div>

    <%- include('partials/ocr-progress-overlay') %>

    <%- include('partials/scripts/ocr-scripts') %>
    <script src="/js/document-omnibox.js"></script>
    <script src="/js/ocr-progress.js"></script>
    <script src="/js/ocr.js"></script>
    <%- include('partials/shell/body-close') %>